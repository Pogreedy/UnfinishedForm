<?xml version="1.0" encoding="utf-8"?>
<creature>
  <info id="29902">
    <narration action="move">
      #0被分配到“0”的收容单元中。
    </narration>
  </info>

  <observe level="1">
    <collection>
      <codeNo openLevel="0">O-00-001</codeNo>
      <portrait openLevel="1">Custom/Unfinished_Form</portrait>
      <name openLevel="1">未竟之形</name>
      <riskLevel openLevel="1">ALEPH</riskLevel>
      <openText>尚未完成、仍在等待被完成的异想体。</openText>
    </collection>

    <desc id="1" openLevel="1">
      [
      “未竟之形”不会主动攻击，但它始终在等待一场没有结束的工作。
      ]
    </desc>
    <desc id="2" openLevel="1">
      [
      完成任意工作后，收容单元的逆卡巴拉计数器有一定概率减少。
      ]
    </desc>
    <desc id="3" openLevel="2">
      [
      压迫工作的结果若为“差”，逆卡巴拉计数器将立即减少。
      ]
    </desc>
    <desc id="4" openLevel="3">
      [
      计数器归零后，“未竟之形”会离开收容单元，开始寻找未完成的工作。
      ]
    </desc>
    <desc id="5" openLevel="3">
      [
      出逃期间，它不会被普通的镇压手段彻底消灭；只有完成它的“未竟之事”才能终止出逃。
      ]
    </desc>

    <specialTipSize size="3">
      <specialTip openLevel="0" key="0">工作结果不为“差”时，可以正常获得 PE-BOX。</specialTip>
      <specialTip openLevel="1" key="1">完成工作后，逆卡巴拉计数器有概率减少。</specialTip>
      <specialTip openLevel="2" key="2">压迫结果为“差”时，逆卡巴拉计数器立即减少。</specialTip>
    </specialTipSize>
  </observe>
</creature>
